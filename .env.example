BOT_TOKEN=your-telegram-bot-token
# Docker Compose image; update this tag explicitly when upgrading.
BOT_IMAGE=ghcr.io/banghasan/telegram-buktikanbot:1.9.0
DOMAIN=your-domain.com
EMAIL=you@example.com
CAPTCHA_LEN=6
CAPTCHA_TIMEOUT_SECONDS=120
CAPTCHA_CAPTION_UPDATE_SECONDS=10
CAPTCHA_WIDTH=320
CAPTCHA_HEIGHT=100
CAPTCHA_OPTION_COUNT=6
CAPTCHA_ATTEMPTS=3
CAPTCHA_OPTION_DIGITS_TO_EMOJI=true
DELETE_JOIN_MESSAGE=true
DELETE_LEFT_MESSAGE=true
BAN_RELEASE_ENABLED=false
BAN_RELEASE_AFTER_SECONDS=14400
BAN_RELEASE_DB_PATH=./buktikan.sqlite
LOG_ENABLED=true
LOG_JSON=false
LOG_LEVEL=info
CAPTCHA_LOG_ENABLED=false
CAPTCHA_LOG_CHAT_ID=
CAPTCHA_LOG_MESSAGE_THREAD_ID=
TIMEZONE=Asia/Jakarta
# polling / webhook
RUN_MODE=polling
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/telegram
WEBHOOK_LISTEN_ADDR=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET_TOKEN=
